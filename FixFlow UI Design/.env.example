# ============================================================================
# Fix Flow — Firebase configuration
#
# Copy this file to `.env` and fill in the values from:
#   Firebase console > your project > Project settings > General
#   > "Your apps" > SDK setup and configuration > Config
#
# These values are PUBLIC by design. The Firebase web config is not a secret;
# access control comes entirely from firestore.rules and storage.rules, both of
# which live in this repo and MUST be deployed:
#
#   firebase deploy --only firestore:rules,storage
#
# NEVER put a service-account key, a Google API secret, or any backend
# credential in this file — anything here ships to the browser.
# ============================================================================

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional — only if Analytics is enabled for the project.
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ----------------------------------------------------------------------------
# AI diagnosis (OPTIONAL).
#
# Leave both blank and the app stores the technician's own diagnosis with
# source: 'technician'. Nothing is fabricated: with no provider configured,
# `requestAiSuggestion()` returns null instead of inventing a result.
#
# To enable a real model, implement the `DiagnosisProvider` interface from
# src/services/diagnosisService.ts against your endpoint and register it once
# at app start with `configureDiagnosisProvider(...)`. The API KEY below
# should be a proxy key for your own backend — do not call a model vendor
# directly from the browser.
# ----------------------------------------------------------------------------
VITE_DIAGNOSIS_API_URL=
VITE_DIAGNOSIS_API_KEY=
